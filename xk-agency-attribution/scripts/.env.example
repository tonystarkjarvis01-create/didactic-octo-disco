SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the n8n webhook that handles link redirects + click logging.
# Should match the path configured in n8n/workflows/link-redirect-logger.json
# (default path: /webhook/r/:code).
REDIRECT_BASE_URL=https://your-n8n-host/webhook/r
