# Optional API keys. The app runs fully without any of these.
# Copy this file to .env and fill in what you have.

# FRED (macro page only) — free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic (optional AI provider). If unset, the app falls back to local
# Ollama (if running) and then to a built-in offline analysis generator.
ANTHROPIC_API_KEY=
